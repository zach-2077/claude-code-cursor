{
  "name": "claude-code-cursor",
  "version": "0.1.0",
  "description": "Use Cursor-provided models inside Claude Code via a local Anthropic /v1/messages proxy",
  "type": "module",
  "bin": {
    "claude-code-cursor": "./bin/ccc.mjs",
    "ccc": "./bin/ccc.mjs"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "serve": "bun run src/cli.ts serve",
    "daemon:start": "./start-daemon.sh",
    "daemon:kill": "./kill-daemon.sh",
    "config:switch": "./switch-claude-config.sh",
    "config:cursor": "./switch-claude-config.sh cursor",
    "config:original": "./switch-claude-config.sh original",
    "config:status": "./switch-claude-config.sh status",
    "start": "bun run src/cli.ts claude",
    "models": "bun run src/cli.ts models",
    "status": "bun run src/cli.ts status",
    "login": "bun run src/cli.ts login"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.15",
    "cursor-opencode-provider": "^0.8.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
