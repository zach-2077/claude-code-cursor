{
  "name": "claude-code-cursor",
  "version": "0.1.0",
  "description": "Use Cursor subscription models inside Claude Code CLI via a local Anthropic /v1/messages Connect-RPC proxy with full tool calling, thinking effort, and 1M Max Mode support",
  "license": "BSD-3-Clause",
  "author": "Zach Zhou (https://github.com/zach-2077)",
  "homepage": "https://github.com/zach-2077/claude-code-cursor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zach-2077/claude-code-cursor.git"
  },
  "bugs": {
    "url": "https://github.com/zach-2077/claude-code-cursor/issues"
  },
  "keywords": [
    "claude-code",
    "claude-cli",
    "cursor",
    "cursor-ai",
    "cursor-agent",
    "anthropic",
    "anthropic-api",
    "anthropic-proxy",
    "v1-messages",
    "llm-proxy",
    "llm-gateway",
    "connect-rpc",
    "ai-coding",
    "coding-agent",
    "opencode-cursor",
    "mcp",
    "model-router"
  ],
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20.0.0"
  },
  "type": "module",
  "bin": {
    "claude-code-cursor": "./bin/ccc.mjs",
    "ccc": "./bin/ccc.mjs"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "serve": "bun run src/cli.ts serve",
    "daemon:start": "./start-daemon.sh",
    "daemon:kill": "./kill-daemon.sh",
    "config:switch": "./switch-claude-config.sh",
    "config:cursor": "./switch-claude-config.sh cursor",
    "config:original": "./switch-claude-config.sh original",
    "config:status": "./switch-claude-config.sh status",
    "start": "bun run src/cli.ts claude",
    "models": "bun run src/cli.ts models",
    "status": "bun run src/cli.ts status",
    "login": "bun run src/cli.ts login"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.15",
    "cursor-opencode-provider": "^0.8.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
